RewriteEngine On

# ---------------------------------------
# Block access to core and storage
RewriteRule ^core/ - [F,L]
RewriteRule ^storage/ - [F,L]

# ---------------------------------------
# Block theme internals except publicly safe files (like assets)
RewriteCond %{REQUEST_URI} !^/theme/assets/
RewriteRule ^theme/(components|layouts)/ - [F,L]

# ---------------------------------------
# Allow sitemap.xml to be routed through PHP
RewriteRule ^sitemap\.xml$ index.php [L]

# ---------------------------------------
# Allow sitemap.xml to be routed through PHP
RewriteRule ^admin/$ index.php [L]

# ---------------------------------------
# Serve existing files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------
# Catch-all: route everything else to index.php
RewriteRule ^ index.php [L,QSA]